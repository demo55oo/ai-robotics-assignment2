<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lane_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and bridge config for the lane-following race.</description>
  <maintainer email="team@example.com">AI Robotics Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>lane_perception</exec_depend>
  <exec_depend>lane_controller</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
